# Archive manifests record exact file bytes. Preserve their line endings on
# every host, independently of the checkout's core.autocrlf setting.
archive/source-library/** -text
compiler/archived/** -text

# Keep official data, generated tables and hash-pinned regression captures exact.
std-lib/data/unicode/** -text
std-lib/src/portable/Unicode.bas -text
compiler/UBE_Compiler_v3/ScannerWords.bas -text
compiler/UBE_Compiler_v3/tests/parser/cli/diagnostic-oom/before-*.json -text

# VB6's source/project importer requires Windows line endings.
bootstrap/UBE-Bootstrap.vbp text eol=crlf
bootstrap/src/*.bas text eol=crlf
