Intrinsic Function StringLength(ByVal Value As String) As Long
End Function
Intrinsic Function StringByteAt(ByVal Value As String, ByVal Index As Long) As Long
End Function
Intrinsic Function StringSlice(ByVal Value As String, ByVal Start As Long, ByVal Length As Long) As String
End Function
Intrinsic Function StringIndexOf(ByVal Value As String, ByVal Needle As String, ByVal Start As Long) As Long
End Function
Intrinsic Function StringFromByte(ByVal Value As Long) As String
End Function
Intrinsic Function LongToString(ByVal Value As Long) As String
End Function
Intrinsic Function CommandArgumentCount() As Long
End Function
Intrinsic Function CommandArgument(ByVal Index As Long) As String
End Function
Intrinsic Function ReadAllText(ByVal Path As String) As String
End Function
Intrinsic Function WriteAllText(ByVal Path As String, ByVal Contents As String) As Long
End Function

Function Main() As Long
    If CommandArgumentCount() <> 2 Then
        Print "usage: ube-stage1 <source.bas> <output.ll>"
        Main = 2
        Exit Function
    End If

    Dim SourcePath As String = CommandArgument(0)
    Dim ResultPath As String = CommandArgument(1)
    Dim SourceText As String = ReadAllText(SourcePath)
    Dim SourceLength As Long = StringLength(SourceText)
    Dim NewLine As String = StringFromByte(10)
    Dim PrintMarker As String = "Print """
    Dim PrintAt As Long = StringIndexOf(SourceText, PrintMarker, 0)

    If PrintAt < 0 Then
        Print "stage one: expected a Print string statement"
        Main = 1
        Exit Function
    End If

    Dim MessageStart As Long = PrintAt + StringLength(PrintMarker)
    Dim Quote As String = """"
    Dim MessageEnd As Long = StringIndexOf(SourceText, Quote, MessageStart)
    If MessageEnd < 0 Then
        Print "stage one: unterminated Print string"
        Main = 1
        Exit Function
    End If
    Dim MessageLength As Long = MessageEnd - MessageStart
    Dim Message As String = StringSlice(SourceText, MessageStart, MessageLength)

    Dim ByteIndex As Long = 0
    While ByteIndex < MessageLength
        Dim CurrentByte As Long = StringByteAt(Message, ByteIndex)
        If CurrentByte < 32 Then
            Print "stage one: Print text must use plain printable UTF-8 bytes"
            Main = 1
            Exit Function
        End If
        If CurrentByte = 34 Then
            Print "stage one: embedded quotes are not supported yet"
            Main = 1
            Exit Function
        End If
        If CurrentByte = 92 Then
            Print "stage one: backslashes are not supported yet"
            Main = 1
            Exit Function
        End If
        ByteIndex = ByteIndex + 1
    Wend

    Dim ExitText As String = "0"
    Dim FunctionAt As Long = StringIndexOf(SourceText, "Function Main", 0)
    If FunctionAt >= 0 Then
        Dim AssignmentMarker As String = "Main = "
        Dim AssignmentAt As Long = StringIndexOf(SourceText, AssignmentMarker, FunctionAt)
        If AssignmentAt < 0 Then
            Print "stage one: Function Main must assign its exit code"
            Main = 1
            Exit Function
        End If
        Dim ExitStart As Long = AssignmentAt + StringLength(AssignmentMarker)
        Dim ExitEnd As Long = StringIndexOf(SourceText, NewLine, ExitStart)
        If ExitEnd < 0 Then
            ExitEnd = SourceLength
        End If
        ExitText = StringSlice(SourceText, ExitStart, ExitEnd - ExitStart)
    End If

    Dim ArrayLength As String = LongToString(MessageLength + 1)
    Dim ResultText As String = "; generated by the first UBE-written compiler" & NewLine
    ResultText = ResultText & "target triple = ""x86_64-w64-windows-gnu""" & NewLine & NewLine
    ResultText = ResultText & "declare i32 @puts(ptr)" & NewLine & NewLine
    ResultText = ResultText & "@.message = private unnamed_addr constant [" & ArrayLength
    ResultText = ResultText & " x i8] c""" & Message & "\00""" & NewLine & NewLine
    ResultText = ResultText & "define i32 @main() {" & NewLine
    ResultText = ResultText & "entry:" & NewLine
    ResultText = ResultText & "  %message = getelementptr inbounds [" & ArrayLength
    ResultText = ResultText & " x i8], ptr @.message, i64 0, i64 0" & NewLine
    ResultText = ResultText & "  %printed = call i32 @puts(ptr %message)" & NewLine
    ResultText = ResultText & "  ret i32 " & ExitText & NewLine
    ResultText = ResultText & "}" & NewLine

    Main = WriteAllText(ResultPath, ResultText)
End Function
