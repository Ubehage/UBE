UBE SOURCE 1 MODULE
Attribute UBE_Name = "NativeArithmetic"

' Scalar LLVM construction over already selected operands. These helpers own
' no payload; all generated bytes/identities use the caller's writer. A failed
' append leaves private output disposable and never publishes an operand.
Function TryLLVMOperation(ByRef Writer As NativeLLVMWriter, ByVal Opcode As String, ByRef Left As NativeOperand, ByRef Right As NativeOperand, ByVal ResultType As Long, ByRef Result As NativeOperand) As Boolean
    TryLLVMOperation = False
    Call ResetNativeFailure(Writer.Failure)
    If Left.TypeId <> Right.TypeId Or Left.Representation <> Right.Representation Or Left.TypeId > 5 Then
        Exit Function
    End If
    Dim Prepared As NativeOperand
    If TryLLVMInstruction(Writer, ResultType, ResultType, Prepared) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, Opcode) = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, Left) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, ", ") = False Then
        Exit Function
    End If
    If TryLLVMOperand(Writer, Right) = False Then
        Exit Function
    End If
    If TryLLVMLine(Writer, "") = False Then
        Exit Function
    End If
    Result = Prepared
    TryLLVMOperation = True
End Function

Function TryLLVMChoose(ByRef Writer As NativeLLVMWriter, ByRef Condition As NativeOperand, ByRef WhenTrue As NativeOperand, ByRef WhenFalse As NativeOperand, ByRef Result As NativeOperand) As Boolean
    TryLLVMChoose = False
    Call ResetNativeFailure(Writer.Failure)
    If Condition.TypeId <> 1 Or WhenTrue.TypeId <> WhenFalse.TypeId Or WhenTrue.Representation <> WhenFalse.Representation Then
        Exit Function
    End If
    Dim Prepared As NativeOperand
    If TryLLVMInstruction(Writer, WhenTrue.TypeId, WhenTrue.Representation, Prepared) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, "select ") = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, Condition) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, ", ") = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, WhenTrue) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, ", ") = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, WhenFalse) = False Then
        Exit Function
    End If
    If TryLLVMLine(Writer, "") = False Then
        Exit Function
    End If
    Result = Prepared
    TryLLVMChoose = True
End Function

Function TryLLVMRecordError(ByRef Writer As NativeLLVMWriter, ByRef Failed As NativeOperand, ByVal Number As Long, ByRef NeedsErrorSupport As Boolean) As Boolean
    TryLLVMRecordError = False
    Call ResetNativeFailure(Writer.Failure)
    If Failed.TypeId <> 1 Then
        Exit Function
    End If
    If TryLLVMText(Writer, "  call void @ube.error.if(") = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, Failed) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, ", i32 ") = False Then
        Exit Function
    End If
    If TryLLVMNumber(Writer, Number) = False Then
        Exit Function
    End If
    If TryLLVMLine(Writer, ")") = False Then
        Exit Function
    End If
    NeedsErrorSupport = True
    TryLLVMRecordError = True
End Function

' Nine bits select the actually used add/subtract/multiply declarations for
' Integer, Long and LongLong, respectively. This is a module-owned scalar;
' declaration emission is once after bodies, with no support runtime calls.
Private Function NativeOverflowBit(ByVal Operation As Long, ByVal Representation As Long) As Long
    Dim Offset As Long = (Representation - 3) * 3
    If Operation = 13 Then
        Offset = Offset + 1
    End If
    If Operation = 8 Then
        Offset = Offset + 2
    End If
    NativeOverflowBit = 1
    While Offset > 0
        NativeOverflowBit = NativeOverflowBit * 2
        Offset = Offset - 1
    Wend
End Function

Private Function TryLLVMOverflowName(ByRef Writer As NativeLLVMWriter, ByVal Operation As Long, ByVal Representation As Long) As Boolean
    TryLLVMOverflowName = False
    Call ResetNativeFailure(Writer.Failure)
    Dim Accepted As Boolean = False
    If Operation = 12 Then
        Accepted = TryLLVMText(Writer, "@llvm.sadd.with.overflow.")
    Else
        If Operation = 13 Then
            Accepted = TryLLVMText(Writer, "@llvm.ssub.with.overflow.")
        Else
            If Operation = 8 Then
                Accepted = TryLLVMText(Writer, "@llvm.smul.with.overflow.")
            End If
        End If
    End If
    If Accepted = False Then
        Exit Function
    End If
    TryLLVMOverflowName = TryLLVMType(Writer, Representation, False)
End Function

Private Function TryLLVMOverflowType(ByRef Writer As NativeLLVMWriter, ByVal Representation As Long) As Boolean
    TryLLVMOverflowType = False
    Call ResetNativeFailure(Writer.Failure)
    If TryLLVMText(Writer, "{ ") = False Then
        Exit Function
    End If
    If TryLLVMType(Writer, Representation, False) = False Then
        Exit Function
    End If
    TryLLVMOverflowType = TryLLVMText(Writer, ", i1 }")
End Function

Private Function TryLLVMOverflowField(ByRef Writer As NativeLLVMWriter, ByVal Pair As LongLong, ByVal Representation As Long, ByVal Field As Long, ByRef Result As NativeOperand) As Boolean
    TryLLVMOverflowField = False
    Call ResetNativeFailure(Writer.Failure)
    Dim TypeId As Long = Representation
    If Field = 1 Then
        TypeId = 1
    End If
    Dim Prepared As NativeOperand
    If TryLLVMInstruction(Writer, TypeId, TypeId, Prepared) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, "extractvalue ") = False Then
        Exit Function
    End If
    If TryLLVMOverflowType(Writer, Representation) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, " %v") = False Then
        Exit Function
    End If
    If TryLLVMNumber(Writer, Pair) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, ", ") = False Then
        Exit Function
    End If
    If TryLLVMNumber(Writer, Field) = False Then
        Exit Function
    End If
    If TryLLVMLine(Writer, "") = False Then
        Exit Function
    End If
    Result = Prepared
    TryLLVMOverflowField = True
End Function

Private Function TryEmitNativeOverflow(ByRef Writer As NativeLLVMWriter, ByVal Operation As Long, ByRef Left As NativeOperand, ByRef Right As NativeOperand, ByRef Result As NativeOperand, ByRef OverflowSupport As Long, ByRef NeedsErrorSupport As Boolean) As Boolean
    TryEmitNativeOverflow = False
    Call ResetNativeFailure(Writer.Failure)
    Dim Pair As LongLong = 0
    If TryLLVMIdentity(Writer, Pair) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, "  %v") = False Then
        Exit Function
    End If
    If TryLLVMNumber(Writer, Pair) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, " = call ") = False Then
        Exit Function
    End If
    If TryLLVMOverflowType(Writer, Left.Representation) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, " ") = False Then
        Exit Function
    End If
    If TryLLVMOverflowName(Writer, Operation, Left.Representation) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, "(") = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, Left) = False Then
        Exit Function
    End If
    If TryLLVMText(Writer, ", ") = False Then
        Exit Function
    End If
    If TryLLVMTypedOperand(Writer, Right) = False Then
        Exit Function
    End If
    If TryLLVMLine(Writer, ")") = False Then
        Exit Function
    End If
    OverflowSupport = OverflowSupport Or NativeOverflowBit(Operation, Left.Representation)
    Dim Value As NativeOperand
    Dim Overflow As NativeOperand
    If TryLLVMOverflowField(Writer, Pair, Left.Representation, 0, Value) = False Then
        Exit Function
    End If
    If TryLLVMOverflowField(Writer, Pair, Left.Representation, 1, Overflow) = False Then
        Exit Function
    End If
    If TryLLVMRecordError(Writer, Overflow, 6, NeedsErrorSupport) = False Then
        Exit Function
    End If
    Dim Neutral As NativeOperand
    Neutral.Kind = 1
    Neutral.TypeId = Left.TypeId
    Neutral.Representation = Left.Representation
    TryEmitNativeOverflow = TryLLVMChoose(Writer, Overflow, Neutral, Value, Result)
End Function

' Select a safe divisor before either LLVM division instruction executes.
' The minimum/-1 remainder is neutral without changing Err; division records
' Err 6 for that pair. A zero divisor records Err 11 for both operations.
Private Function TryEmitNativeDivision(ByRef Writer As NativeLLVMWriter, ByVal Operation As Long, ByRef OperandType As SemanticType, ByRef Left As NativeOperand, ByRef Right As NativeOperand, ByRef Result As NativeOperand, ByRef NeedsErrorSupport As Boolean) As Boolean
    TryEmitNativeDivision = False
    Call ResetNativeFailure(Writer.Failure)
    Dim Literal As NativeOperand
    Literal.Kind = 1
    Literal.TypeId = Left.TypeId
    Literal.Representation = Left.Representation
    Dim Zero As NativeOperand
    Dim Minimum As NativeOperand
    Dim MinusOne As NativeOperand
    Dim Exceptional As NativeOperand
    Dim Unsafe As NativeOperand
    If TryLLVMOperation(Writer, "icmp eq ", Right, Literal, 1, Zero) = False Then
        Exit Function
    End If
    Literal.Value = OperandType.Minimum
    If TryLLVMOperation(Writer, "icmp eq ", Left, Literal, 1, Minimum) = False Then
        Exit Function
    End If
    Literal.Value = -1
    If TryLLVMOperation(Writer, "icmp eq ", Right, Literal, 1, MinusOne) = False Then
        Exit Function
    End If
    If TryLLVMOperation(Writer, "and ", Minimum, MinusOne, 1, Exceptional) = False Then
        Exit Function
    End If
    If TryLLVMOperation(Writer, "or ", Zero, Exceptional, 1, Unsafe) = False Then
        Exit Function
    End If
    If TryLLVMRecordError(Writer, Zero, 11, NeedsErrorSupport) = False Then
        Exit Function
    End If
    If Operation = 10 Then
        If TryLLVMRecordError(Writer, Exceptional, 6, NeedsErrorSupport) = False Then
            Exit Function
        End If
    End If
    Dim Divisor As NativeOperand
    Literal.Value = 1
    If TryLLVMChoose(Writer, Unsafe, Literal, Right, Divisor) = False Then
        Exit Function
    End If
    Dim Value As NativeOperand
    Dim Accepted As Boolean = False
    If Operation = 10 Then
        Accepted = TryLLVMOperation(Writer, "sdiv ", Left, Divisor, Left.TypeId, Value)
    Else
        Accepted = TryLLVMOperation(Writer, "srem ", Left, Divisor, Left.TypeId, Value)
    End If
    If Accepted = False Then
        Exit Function
    End If
    Literal.Value = 0
    TryEmitNativeDivision = TryLLVMChoose(Writer, Unsafe, Literal, Value, Result)
End Function

' Operands have already undergone the exact conversion facts at their source
' evaluation points. This routine neither evaluates children nor chooses types.
' Short-circuit operators belong to the ordered control-flow consumer.
Function TryEmitNativeBinary(ByRef Writer As NativeLLVMWriter, ByRef Node As BoundNode, ByRef OperandType As SemanticType, ByRef Left As NativeOperand, ByRef Right As NativeOperand, ByRef Result As NativeOperand, ByRef OverflowSupport As Long, ByRef NeedsErrorSupport As Boolean) As Boolean
    TryEmitNativeBinary = False
    Call ResetNativeFailure(Writer.Failure)
    If Node.Kind <> 5 Or Node.ChildCount <> 2 Or Left.TypeId <> Right.TypeId Or Left.Representation <> Right.Representation Then
        Exit Function
    End If
    If Left.TypeId >= 6 Then
        If Node.TypeId <> 1 Or (Node.Auxiliary <> 15 And Node.Auxiliary <> 16) Then
            Exit Function
        End If
        Dim LeftBits As NativeOperand
        Dim RightBits As NativeOperand
        If TryEmitNativeRepresentation(Writer, 2, OperandType, Left.TypeId, Left, LeftBits) = False Then
            Exit Function
        End If
        If TryEmitNativeRepresentation(Writer, 2, OperandType, Right.TypeId, Right, RightBits) = False Then
            Exit Function
        End If
        If Node.Auxiliary = 15 Then
            TryEmitNativeBinary = TryLLVMOperation(Writer, "icmp eq ", LeftBits, RightBits, 1, Result)
        Else
            TryEmitNativeBinary = TryLLVMOperation(Writer, "icmp ne ", LeftBits, RightBits, 1, Result)
        End If
        Exit Function
    End If
    If Left.TypeId <> Left.Representation Or (Left.TypeId <> 1 And (Left.TypeId < 3 Or Left.TypeId > 5)) Then
        Exit Function
    End If
    Dim Operation As Long = Node.Auxiliary
    If Operation >= 15 And Operation <= 20 Then
        If Node.TypeId <> 1 Or (Left.TypeId = 1 And Operation > 16) Then
            Exit Function
        End If
        Dim Comparison As String = "icmp eq "
        If Operation = 16 Then
            Comparison = "icmp ne "
        End If
        If Operation = 17 Then
            Comparison = "icmp slt "
        End If
        If Operation = 18 Then
            Comparison = "icmp sle "
        End If
        If Operation = 19 Then
            Comparison = "icmp sgt "
        End If
        If Operation = 20 Then
            Comparison = "icmp sge "
        End If
        TryEmitNativeBinary = TryLLVMOperation(Writer, Comparison, Left, Right, 1, Result)
        Exit Function
    End If
    If Node.TypeId <> Left.TypeId Then
        Exit Function
    End If
    If Operation = 12 Or Operation = 13 Or Operation = 8 Then
        If Left.TypeId < 3 Then
            Exit Function
        End If
        TryEmitNativeBinary = TryEmitNativeOverflow(Writer, Operation, Left, Right, Result, OverflowSupport, NeedsErrorSupport)
        Exit Function
    End If
    If Operation = 10 Or Operation = 11 Then
        If Left.TypeId < 3 Or OperandType.Kind <> 2 Or OperandType.Minimum >= 0 Then
            Exit Function
        End If
        TryEmitNativeBinary = TryEmitNativeDivision(Writer, Operation, OperandType, Left, Right, Result, NeedsErrorSupport)
        Exit Function
    End If
    Dim Opcode As String = ""
    If Operation = 24 Then
        Opcode = "and "
    End If
    If Operation = 26 Then
        Opcode = "or "
    End If
    If Operation = 28 Or Operation = 29 Then
        Opcode = "xor "
    End If
    Dim Complement As NativeOperand
    Complement.Kind = 1
    Complement.TypeId = Left.TypeId
    Complement.Representation = Left.Representation
    Complement.Value = -1
    If Left.TypeId = 1 Then
        Complement.Value = 1
    End If
    Dim Prepared As NativeOperand
    If Operation = 30 Then
        If TryLLVMOperation(Writer, "xor ", Left, Complement, Left.TypeId, Prepared) = False Then
            Exit Function
        End If
        TryEmitNativeBinary = TryLLVMOperation(Writer, "or ", Prepared, Right, Left.TypeId, Result)
        Exit Function
    End If
    If Opcode = "" Then
        Exit Function
    End If
    If TryLLVMOperation(Writer, Opcode, Left, Right, Left.TypeId, Prepared) = False Then
        Exit Function
    End If
    If Operation = 29 Then
        If TryLLVMOperation(Writer, "xor ", Prepared, Complement, Left.TypeId, Prepared) = False Then
            Exit Function
        End If
    End If
    Result = Prepared
    TryEmitNativeBinary = True
End Function

Function TryEmitNativeUnary(ByRef Writer As NativeLLVMWriter, ByRef Node As BoundNode, ByRef Operand As NativeOperand, ByRef Result As NativeOperand, ByRef OverflowSupport As Long, ByRef NeedsErrorSupport As Boolean) As Boolean
    TryEmitNativeUnary = False
    Call ResetNativeFailure(Writer.Failure)
    If Node.Kind <> 4 Or Node.ChildCount <> 1 Or Node.TypeId <> Operand.TypeId Or Operand.TypeId <> Operand.Representation Then
        Exit Function
    End If
    If Operand.TypeId <> 1 And (Operand.TypeId < 3 Or Operand.TypeId > 5) Then
        Exit Function
    End If
    If Node.Auxiliary = 4 And Operand.TypeId >= 3 Then
        Result = Operand
        TryEmitNativeUnary = True
        Exit Function
    End If
    Dim Literal As NativeOperand
    Literal.Kind = 1
    Literal.TypeId = Operand.TypeId
    Literal.Representation = Operand.Representation
    If Node.Auxiliary = 5 And Operand.TypeId >= 3 Then
        TryEmitNativeUnary = TryEmitNativeOverflow(Writer, 13, Literal, Operand, Result, OverflowSupport, NeedsErrorSupport)
        Exit Function
    End If
    If Node.Auxiliary = 6 Then
        Literal.Value = -1
        If Operand.TypeId = 1 Then
            Literal.Value = 1
        End If
        TryEmitNativeUnary = TryLLVMOperation(Writer, "xor ", Operand, Literal, Operand.TypeId, Result)
    End If
End Function

Function TryEmitNativeOverflowDeclarations(ByRef Writer As NativeLLVMWriter, ByVal OverflowSupport As Long) As Boolean
    TryEmitNativeOverflowDeclarations = False
    Call ResetNativeFailure(Writer.Failure)
    If OverflowSupport < 0 Or OverflowSupport > 511 Then
        Exit Function
    End If
    Dim Representation As Long = 3
    While Representation <= 5
        Dim Index As Long = 0
        While Index < 3
            Dim Operation As Long = 12 + Index
            If Index = 2 Then
                Operation = 8
            End If
            If (OverflowSupport And NativeOverflowBit(Operation, Representation)) <> 0 Then
                Dim Identity As LongLong = 0
                If TryLLVMIdentity(Writer, Identity) = False Then
                    Exit Function
                End If
                If TryLLVMText(Writer, "declare ") = False Then
                    Exit Function
                End If
                If TryLLVMOverflowType(Writer, Representation) = False Then
                    Exit Function
                End If
                If TryLLVMText(Writer, " ") = False Then
                    Exit Function
                End If
                If TryLLVMOverflowName(Writer, Operation, Representation) = False Then
                    Exit Function
                End If
                If TryLLVMText(Writer, "(") = False Then
                    Exit Function
                End If
                If TryLLVMType(Writer, Representation, False) = False Then
                    Exit Function
                End If
                If TryLLVMText(Writer, ", ") = False Then
                    Exit Function
                End If
                If TryLLVMType(Writer, Representation, False) = False Then
                    Exit Function
                End If
                If TryLLVMLine(Writer, ")") = False Then
                    Exit Function
                End If
            End If
            Index = Index + 1
        Wend
        Representation = Representation + 1
    Wend
    TryEmitNativeOverflowDeclarations = True
End Function
