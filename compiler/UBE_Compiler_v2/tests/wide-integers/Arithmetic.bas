Function WideAdd(ByVal Left As LongLong, ByVal Right As LongLong) As LongLong
    WideAdd = Left + Right
End Function
Function WideSubtract(ByVal Left As LongLong, ByVal Right As LongLong) As LongLong
    WideSubtract = Left - Right
End Function
Function WideMultiply(ByVal Left As LongLong, ByVal Right As LongLong) As LongLong
    WideMultiply = Left * Right
End Function
Function WideDivide(ByVal Left As LongLong, ByVal Right As LongLong) As LongLong
    WideDivide = Left \ Right
End Function
Function WideRemainder(ByVal Left As LongLong, ByVal Right As LongLong) As LongLong
    WideRemainder = Left Mod Right
End Function
Function WideNegate(ByVal Value As LongLong) As LongLong
    WideNegate = -Value
End Function
Function WideToLong(ByVal Value As LongLong) As Long
    WideToLong = Value
End Function
Function WideToInteger(ByVal Value As LongLong) As Integer
    WideToInteger = Value
End Function
Function WideToByte(ByVal Value As LongLong) As Byte
    WideToByte = Value
End Function
Function Main() As Long
    Main = 0
End Function
