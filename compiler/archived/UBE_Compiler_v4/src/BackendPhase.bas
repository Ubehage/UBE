UBE SOURCE 1 MODULE
Attribute UBE_Name = "BackendPhase"

Type BackendFragmentResult
    Succeeded As Long
    FunctionId As Long
    TargetTriple As String
    LlvmText As String
    ArtifactBytes As Long
    WorkUnits As LongLong
    Dump As String
End Type

Sub ReleaseBackendFragment(ByRef Result As BackendFragmentResult)
    Result.Succeeded = 0: Result.LlvmText = "": Result.Dump = ""
End Sub

Function ValidateBackendFragment(ByVal Result As BackendFragmentResult) As Long
    If Result.Succeeded <> 0 And Result.FunctionId = 1 And Result.TargetTriple = "x86_64-w64-windows-gnu" And Result.ArtifactBytes = CompilerTextLength(Result.LlvmText) And Result.ArtifactBytes > 0 Then ValidateBackendFragment = 1 Else ValidateBackendFragment = 0
End Function

Function RunBackendPhase(ByVal Session As BuildSession, ByVal Source As SourceSetResult, ByVal FunctionResult As VerifiedFunctionResult, ByRef Result As BackendFragmentResult, ByRef Diagnostics() As CompilerDiagnostic, ByRef DiagnosticCount As Long, ByRef DiagnosticCapacity As Long) As Long
    Call ReleaseBackendFragment(Result)
    If ValidateVerifiedFunction(FunctionResult) = 0 Then RunBackendPhase = 0: Exit Function
    Dim TextLength As Long = CompilerTextLength(FunctionResult.PrintText) + 1
    Dim LF As String = CompilerTextFromByte(10)
    Dim Quote As String = CompilerTextFromByte(34)
    Dim Llvm As String = "; generated by UBE Compiler v4 Task 3" & LF
    Llvm = Llvm & "target datalayout = " & Quote & "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128" & Quote & LF
    Llvm = Llvm & "target triple = " & Quote & Session.TargetTriple & Quote & LF & LF
    Llvm = Llvm & "@.ube.v4.task3.text = private unnamed_addr constant [" & CompilerLongToText(TextLength) & " x i8] c" & Quote & FunctionResult.PrintText & "\00" & Quote & LF
    Llvm = Llvm & "declare void @ube_runtime_set_args(i32, ptr)" & LF
    Llvm = Llvm & "declare void @ube_print_string(ptr)" & LF
    Llvm = Llvm & "declare void @ube_print_newline()" & LF & LF
    Llvm = Llvm & "define void @ube_v4_task3_main() {" & LF & "entry:" & LF
    Llvm = Llvm & "  %text = getelementptr inbounds [" & CompilerLongToText(TextLength) & " x i8], ptr @.ube.v4.task3.text, i64 0, i64 0" & LF
    Llvm = Llvm & "  call void @ube_print_string(ptr %text)" & LF & "  call void @ube_print_newline()" & LF & "  ret void" & LF & "}" & LF & LF
    Llvm = Llvm & "define i32 @main(i32 %argc, ptr %argv) {" & LF & "entry:" & LF
    Llvm = Llvm & "  call void @ube_runtime_set_args(i32 %argc, ptr %argv)" & LF & "  call void @ube_v4_task3_main()" & LF & "  ret i32 0" & LF & "}" & LF
    If CompilerTextLength(Llvm) > Session.MaximumArtifactBytes Then
        Call AddCompilerDiagnostic(Diagnostics, DiagnosticCount, DiagnosticCapacity, Session.MaximumDiagnostics, "UBE6107", Session.OutputPath, "LLVM artifact exceeds the session limit")
        RunBackendPhase = 0
        Exit Function
    End If
    Result.FunctionId = FunctionResult.FunctionId: Result.TargetTriple = Session.TargetTriple
    Result.LlvmText = Llvm: Result.ArtifactBytes = CompilerTextLength(Llvm)
    Result.WorkUnits = FunctionResult.InstructionCount: Result.Succeeded = 1
    Call AppendPhaseField(Result.Dump, "phase", "backend")
    Call AppendPhaseField(Result.Dump, "function-id", "1")
    Call AppendPhaseField(Result.Dump, "target", Result.TargetTriple)
    Call AppendPhaseField(Result.Dump, "llvm-bytes", CompilerLongToText(Result.ArtifactBytes))
    If Session.FaultSite = "backend-envelope" Then Result.ArtifactBytes = 0
    If ValidateBackendFragment(Result) = 0 Then
        Call AddCompilerDiagnostic(Diagnostics, DiagnosticCount, DiagnosticCapacity, Session.MaximumDiagnostics, "UBE6108", Source.SourcePath, "backend published an invalid envelope")
        RunBackendPhase = 0
        Exit Function
    End If
    RunBackendPhase = 1
End Function
